# AYA.ONE Identity Stack — environment configuration.
# Everything is OPTIONAL. With nothing set, the stack runs fully in MOCK mode
# (no external network/credentials) so the demo and CI work out of the box.

# --- API server ---
PORT=8787

# --- IOTA Identity (did:iota anchoring) ---
# When set, the DID adapter will use the real IOTA network instead of local DIDs.
# IOTA_NETWORK=testnet
# IOTA_NODE_URL=https://api.testnet.iota.cafe

# --- walt.id (credential issuance / verification via OID4VC) ---
# When set, issuance/verification is delegated to a running walt.id stack.
# WALTID_ISSUER_URL=http://localhost:7002
# WALTID_VERIFIER_URL=http://localhost:7003

# --- World ID (proof of personhood for humans) ---
# When set, human proofs are verified against the World Developer Portal.
# WORLD_APP_ID=app_xxxxxxxxxxxxxxxxxxxxxxxxx
# WORLD_RP_ID=rp_xxxxxxxxxxxxxxxxxxxxxxxxx
# WORLD_ACTION=aya-onboard

# Front-end (Vite) — expose the World ID app id to the browser widget.
# VITE_WORLD_APP_ID=app_xxxxxxxxxxxxxxxxxxxxxxxxx
# VITE_WORLD_ACTION=aya-onboard
